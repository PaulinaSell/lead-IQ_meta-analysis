@article{nevin2009TrendsPreschoolLead,
  title = {Trends in Preschool Lead Exposure, Mental Retardation, and Scholastic Achievement: Association or Causation?},
  author = {Nevin, R.},
  year = 2009,
  month = apr,
  journal = {Environmental research},
  edition = {2009/01/27},
  volume = {109},
  number = {3},
  pages = {301--10},
  issn = {0013-9351},
  doi = {10.1016/j.envres.2008.12.003},
  abstract = {This study shows that 1936-1990 preschool blood lead trends explain 65\% of the 1948-2001 variation in USA mental retardation (MR) prevalence, 45\% of the 1953-2003 variation in the average scholastic achievement test (SAT) verbal score, and 65\% of the 1953-2003 variation in the average SAT math score. These temporal relationships are characterized by best-fit time lags (highest R(2) and t-value for blood lead) consistent with lead-induced cognitive damage in the first year of life: a 12-year lag for school-age MR, and a 17-year lag for SAT scores. Recent shifts in age-specific MR prevalence are consistent with recent trends in preschool blood lead. SAT and MR trends by race are consistent with racial differences in how 1960s slum clearance affected childhood exposure to severe lead paint hazards. SAT trends by Hispanic origin are consistent with an especially sharp fall in preschool blood lead in New York City since 1970.},
  langid = {english},
  keywords = {Child Preschool,Educational Status,Environmental Exposure/*adverse effects,Environmental Pollutants/blood/*toxicity,Female,Hispanic or Latino,Humans,Intellectual Disability/*chemically induced/epidemiology/ethnology,Intelligence Tests,Lead/blood/*toxicity,Male,New York City/epidemiology,Prevalence,Regression Analysis}
}

