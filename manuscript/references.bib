  keywords = {*Polymorphism Genetic,Adult,Apolipoprotein E,Apolipoproteins E/*genetics/metabolism,Child Development/drug effects,Cognition/*drug effects,Cord blood,Croatia/epidemiology,Environmental Pollutants/blood/*toxicity,Female,Food Contamination/analysis,Genetic polymorphism,Humans,Infant,Lead,Male,Mercury,Mercury/blood/*toxicity,Motor Skills/*drug effects,Neurodevelopment,Pregnancy,Prenatal Exposure Delayed Effects/chemically induced/*epidemiology,Selenium,Selenium/blood,Slovenia/epidemiology,Young Adult}
}

