  volume = {5},
  number = {3},
  pages = {e121-e134},
  issn = {2542-5196},
  doi = {10.1016/S2542-5196(20)30272-2},
  abstract = {BackgroundAmbient air pollution is a major environmental cause of morbidity and mortality worldwide. Cities are generally hotspots for air pollution and disease. However, the exact extent of the health effects of air pollution at the city level is still largely unknown. We aimed to estimate the proportion of annual preventable deaths due to air pollution in almost 1000 cities in Europe.}
