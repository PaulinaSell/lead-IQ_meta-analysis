@article{hvidtfeldt2019LongtermResidentialExposure,
  type = {Journal {{Article}}},
  title = {Long-Term Residential Exposure to {{PM2}}.5, {{PM10}}, Black Carbon, {{NO2}}, and Ozone and Mortality in a {{Danish}} Cohort},
  author = {Hvidtfeldt, Ulla Arthur and S{\o}rensen, Mette and Geels, Camilla and Ketzel, Matthias and Khan, Jibran and Tj{\o}nneland, Anne and Overvad, Kim and Brandt, J{\o}rgen and {Raaschou-Nielsen}, Ole},
  year = 2019,
  journal = {Environ Int},
  volume = {123},
  pages = {265--272},
  issn = {0160-4120},
  doi = {10.1016/j.envint.2018.12.010},
  abstract = {Air pollutants such as NO2 and PM2.5 have consistently been linked to mortality, but only few previous studies have addressed associations with long-term exposure to black carbon (BC) and ozone (O3). We investigated the association between PM2.5, PM10, BC, NO2, and O3 and mortality in a Danish cohort of 49,564 individuals who were followed up from enrollment in 1993--1997 through 2015. Residential address history from 1979 onwards was combined with air pollution exposure obtained by the state-of-the-art, validated, THOR/AirGIS air pollution modelling system, and information on residential traffic noise exposure, lifestyle and socio-demography. We observed higher risks of all-cause as well as cardiovascular disease (CVD) mortality with higher long-term exposure to PM2.5, PM10, BC, and NO2. For PM2.5 and CVD mortality, a hazard ratio (HR) of 1.29 (95},
  keywords = {Particulate matter NO Black carbon Ozone CVD Mortality Epidemiology}
}

