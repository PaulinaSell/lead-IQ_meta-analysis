@article{youn2010PorphyrinuriaKoreanChildren,
  title = {Porphyrinuria in {{Korean}} Children with Autism: Correlation with Oxidative Stress},
  author = {Youn, S. I. and Jin, S. H. and Kim, S. H. and Lim, S.},
  year = 2010,
  journal = {Journal of toxicology and environmental health. Part A},
  edition = {2010/04/15},
  volume = {73},
  number = {10},
  pages = {701--10},
  issn = {1528-7394 (Print) 0098-4108},
  doi = {10.1080/15287391003614000},
  abstract = {Autism spectrum disorder (ASD) is a neurodevelopmental disorder believed to be associated with heavy metal exposure, especially mercury (Hg), and is characterized by disturbances in metal elimination. Various studies correlated elevated heavy metal body burden with ASD diagnoses as evidenced by increased urinary porphyrin levels in patients. Urinary porphyrins were also determined in Korean patients diagnosed with ASD (n = 65) who visited AK Eastern Medicinal Clinic in Kangnam-gu, Seoul, from June 2007 to September 2008, compared to controls (n = 9) residing in the same area, by means of Metametrix (CLIA-approved) laboratory testing. Further, urinary organic acids as indicators of hepatic detoxification/oxidative stress were also analyzed among patients diagnosed with ASD. Significant increases were found in patients diagnosed with ASD for proporphyrins, pentacarboxyporphyrin, precoproporphyrin, coproporphyrins, and total porphyrins. Significant correlations were observed between hepatic detoxification/oxidative stress markers and urinary porphyrins. In agreement with published data, the present results demonstrated that measurement of porphyrins serves as a reliable tool for diagnosis of heavy metal involvement in ASD.},
  langid = {english},
  keywords = {*Oxidative Stress/drug effects,Adolescent,Autistic Disorder/epidemiology/*urine,Biomarkers/urine,Body Burden,Child,Child Preschool,Chromatography High Pressure Liquid,Female,Humans,Male,Metals Heavy/adverse effects/metabolism,Porphyrins/*urine,Republic of Korea/epidemiology,Tandem Mass Spectrometry}
}

