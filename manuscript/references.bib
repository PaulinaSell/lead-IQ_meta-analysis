@article{marcus2010LeadConductProblems,
  title = {Lead and Conduct Problems: A Meta-Analysis},
  author = {Marcus, D. K. and Fulton, J. J. and Clarke, E. J.},
  year = 2010,
  journal = {Journal of clinical child and adolescent psychology : the official journal for the Society of Clinical Child and Adolescent Psychology, American Psychological Association, Division 53},
  edition = {2010/04/15},
  volume = {39},
  number = {2},
  pages = {234--41},
  issn = {1537-4416},
  doi = {10.1080/15374411003591455},
  abstract = {This meta-analysis examined the association between conduct problems and lead exposure. Nineteen studies on 8,561 children and adolescents were included. The average r across all 19 studies was .19 (p {$<$} .001), which is considered a medium effect size. Studies that assessed lead exposure using hair element analysis yielded considerably larger effect sizes than those that assessed lead exposure using blood, tooth, or bone lead levels. Excluding the 3 hair analysis studies, the average r was .15 (p {$<$} .001). The age of the participants did not significantly moderate the relation between lead exposure and conduct problems. Overall, the relation between lead exposure and conduct problems was strikingly similar in magnitude to the relation between lead exposure and decreased IQ.},
  langid = {english},
  keywords = {Adolescent,Bone and Bones/chemistry,Child,Conduct Disorder/*etiology/psychology,Female,Hair/chemistry,Humans,Lead Poisoning Nervous System Childhood/*complications/psychology,Lead/analysis,Male}
}

