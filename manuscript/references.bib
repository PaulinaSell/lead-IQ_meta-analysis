@article{khomenko2021PrematureMortalityDue,
  type = {Journal {{Article}}},
  title = {Premature Mortality Due to Air Pollution in {{European}} Cities: A Health Impact Assessment},
  author = {Khomenko, Sasha and Cirach, Marta and {Pereira-Barboza}, Evelise and Mueller, Natalie and {Barrera-G{\'o}mez}, Jose and {Rojas-Rueda}, David and {de Hoogh}, Kees and Hoek, Gerard and Nieuwenhuijsen, Mark},
  year = 2021,
