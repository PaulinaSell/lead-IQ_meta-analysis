@article{love2022ContributionChildABCtransporter,
  title = {Contribution of Child {{ABC-transporter}} Genetics to Prenatal {{MeHg}} Exposure and Neurodevelopment},
  author = {Love, T. M. and Wahlberg, K. and Pineda, D. and Watson, G. E. and Zareba, G. and Thurston, S. W. and Davidson, P. W. and Shamlaye, C. F. and Myers, G. J. and Rand, M. and {van Wijngaarden}, E. and Broberg, K.},
  year = 2022,
  month = jul,
  journal = {Neurotoxicology},
  edition = {2022/06/03},
  volume = {91},
  pages = {228--233},
  issn = {0161-813X (Print) 0161-813x},
  doi = {10.1016/j.neuro.2022.05.019},
  abstract = {BACKGROUND: There is emerging evidence that exposure to prenatal methylmercury (MeHg) from maternal fish consumption during pregnancy can differ between individuals due to genetic variation. In previous studies, we have reported that maternal polymorphisms in ABC-transporter genes were associated with maternal hair MeHg concentrations, and with children's early neurodevelopmental tests. In this study, we add to these findings by evaluating the contribution of genetic variation in children's ABC-transporter genes to prenatal MeHg exposure and early child neurodevelopmental tests. METHODS: We genotyped six polymorphisms (rs2032582, rs10276499 and rs1202169 in ABCB1; rs11075290 and rs215088 in ABCC1; rs717620 in ABCC2) in DNA from cord blood and maternal blood of the Seychelles Child Development Study Nutrition Cohort 2. We determined prenatal MeHg exposure by measuring total mercury (Hg) in cord blood by atomic fluorescence spectrometry. We assessed neurodevelopment in children at approximately 20 months using the Bayley Scales of Infant Development (BSID-II). We used linear regression models to analyze covariate-adjusted associations of child genotype with cord MeHg and BSID-II outcomes (Mental Developmental and Psychomotor Developmental Indexes). We also evaluated interactions between genotypes, cord MeHg, and neurodevelopmental outcomes. All models were run with and without adjustment for maternal genotype. RESULTS: Of the six evaluated polymorphisms, only ABCC1 rs11075290 was associated with cord blood MeHg; children homozygous for the T-allele had on average 29.99~\textmu g/L MeHg in cord blood while those homozygous for the C-allele had on average 38.06~\textmu g/L MeHg in cord blood (p~{$<~$}0.001). No polymorphisms in the children were associated with either subscale of the BSID. However, the association between cord MeHg and the Mental Developmental Index (MDI) of the BSID differed significantly across the three genotypes of ABCB1 rs10276499 (2df F-test, p~=~0.045). With increasing cord MeHg, the MDI decreased (slope=-0.091, p~=~0.014) among children homozygous for the rare C-allele. CONCLUSIONS: These findings support the possibility that child ABC genetics might influence prenatal MeHg exposure.},
  langid = {english},
  keywords = {*ATP-Binding Cassette Transporters/genetics,*Mercury,*Methylmercury Compounds/adverse effects,*Prenatal Exposure Delayed Effects/genetics,ATP-binding cassette transporters,Child Development,Cohort Studies,Female,Fish Products,Humans,Infant,Infant Newborn,Maternal Exposure,Mdr1,Mrp1,Mrp2,Neurodevelopment,P-Glycoprotein,Pregnancy,Seafood/toxicity,Seychelles}
}

