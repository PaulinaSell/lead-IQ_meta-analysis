@article{trasande2016BurdenDiseaseCosts,
  type = {Journal {{Article}}},
  title = {Burden of Disease and Costs of Exposure to Endocrine Disrupting Chemicals in the {{European Union}}: An Updated Analysis},
  author = {Trasande, L. and Zoeller, R. T. and Hass, U. and Kortenkamp, A. and Grandjean, P. and Myers, J. P. and DiGangi, J. and Hunt, P. M. and Rudel, R. and Sathyanarayana, S. and Bellanger, M. and Hauser, R. and Legler, J. and Skakkebaek, N. E. and Heindel, J. J.},
  year = 2016,
  journal = {Andrology},
  volume = {4},
