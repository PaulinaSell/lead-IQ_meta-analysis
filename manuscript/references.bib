  keywords = {*Breast Feeding,*Maternal Exposure,Central Nervous System/growth & development,Dose-Response Relationship Drug,Ethylmercury Compounds/chemistry,Female,Humans,Infant,Infant Newborn,Infant Premature,Mercury/*analysis/metabolism,Milk Human/*chemistry,Preservatives Pharmaceutical/chemistry,Risk Factors,Thimerosal/chemistry,Vaccines/*analysis}
}

