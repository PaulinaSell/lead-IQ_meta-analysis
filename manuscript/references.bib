@article{bellinger2005PilotStudyBlood,
  title = {A Pilot Study of Blood Lead Levels and Neurobehavioral Function in Children Living in {{Chennai}}, {{India}}},
  author = {Bellinger, D. C. and Hu, H. and Kalaniti, K. and Thomas, N. and Rajan, P. and Sambandam, S. and Ramaswamy, P. and Balakrishnan, K.},
  year = 2005,
  month = apr,
  journal = {International journal of occupational and environmental health},
  edition = {2005/05/07},
  volume = {11},
  number = {2},
  pages = {138--43},
  issn = {1077-3525 (Print) 1077-3525},
  doi = {10.1179/oeh.2005.11.2.138},
  abstract = {The relationship between blood lead level and neurodevelopment was assessed in a pilot cross-sectional study of 74 4-14-year-old children in Chennai, India. Mean blood lead level was 11.1 microg/dL (2.5-38.3). The Binet-Kamath IQ test and the Wide Range Assessment of Visual Motor Activity (WRAVMA) were administered to 58 children. Teachers completed the Connor's Behavioral Rating Scale. Excluding two outliers, IQ and WRAVMA composite scores were inversely related to blood lead level, with an effect size of approximately 6 points decline for a 10-microg/dL increase in blood lead. Children in the highest and lowest blood lead quartiles had mean IQs of 95.6+/-13.3 and 102.0+/-22.5, respectively. Behavior ratings were not associated with blood lead level. Lead exposure is a significant problem among Indian children, with many having blood lead levels associated with increased neurodevelopmental risk.},
  langid = {english},
  keywords = {*Environmental Exposure,Adolescent,Child,Child Behavior Disorders/etiology,Child Development,Child Preschool,Cognition Disorders/epidemiology/*etiology,Cross-Sectional Studies,Female,Humans,Incidence,India,Intelligence Tests,Lead Poisoning/*complications,Lead/*blood,Male,Risk Assessment}
}

