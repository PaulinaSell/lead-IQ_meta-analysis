@article{ryan2008CombiningDataMultiple,
  title = {Combining Data from Multiple Sources, with Applications to Environmental Risk Assessment},
  author = {Ryan, L.},
  year = 2008,
  month = feb,
  journal = {Statistics in medicine},
  edition = {2007/12/12},
  volume = {27},
  number = {5},
  pages = {698--710},
  issn = {0277-6715 (Print) 0277-6715},
  doi = {10.1002/sim.3053},
  abstract = {The classical statistical paradigm emphasizes the development and application of methods to account for sampling variability. Many modern day applications, however, require consideration of other sources of uncertainty that are not so easy to quantify. This paper presents a case study involving an assessment of the impact of in-utero methylmercury exposure on the Intelligence Quotient (IQ) of young children. We illustrate how familiar techniques such as hierarchical modeling, Bayesian methods and sensitivity analysis can be used to aid decision making in settings that involve substantial uncertainty.},
  langid = {english},
  keywords = {Data Interpretation Statistical,Decision Making,Environmental Exposure/*statistics & numerical data,Hazardous Substances/*adverse effects,Humans,Intelligence/drug effects,Methylmercury Compounds/adverse effects,Risk Assessment/*statistics & numerical data,Uncertainty}
}

