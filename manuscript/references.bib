@article{pan2022AdvancesInfluenceMethylmercury,
  title = {Advances on the {{Influence}} of {{Methylmercury Exposure}} during {{Neurodevelopment}}},
  author = {Pan, J. and Li, X. and Wei, Y. and Ni, L. and Xu, B. and Deng, Y. and Yang, T. and Liu, W.},
  year = 2022,
  month = jan,
  journal = {Chemical research in toxicology},
  edition = {2022/01/07},
  volume = {35},
  number = {1},
  pages = {43--58},
  issn = {0893-228x},
  doi = {10.1021/acs.chemrestox.1c00255},
  abstract = {Mercury (Hg) is a toxic heavy-metal element, which can be enriched in fauna and flora and transformed into methylmercury (MeHg). MeHg is a widely distributed environmental pollutant that may be harmful to fish-eating populations through enrichment of aquatic food chains. The central nervous system is a primary target of MeHg. Embryos and infants are more sensitive to MeHg, and exposure to MeHg during gestational feeding can significantly impair the homeostasis of offspring, leading to long-term neurodevelopmental defects. At present, MeHg-induced neurodevelopmental toxicity has become a hotspot in the field of neurotoxicology, but its mechanisms are not fully understood. Some evidence point to oxidative damage, excitotoxicity, calcium ion imbalance, mitochondrial dysfunction, epigenetic changes, and other molecular mechanisms that play important roles in MeHg-induced neurodevelopmental toxicity. In this review, advances in the study of neurodevelopmental toxicity of MeHg exposure during pregnancy and the molecular mechanisms of related pathways are summarized, in order to provide more scientific basis for the study of neurodevelopmental toxicity of MeHg.},
  langid = {english},
  keywords = {Animals,Environmental Pollutants/*adverse effects,Humans,Methylmercury Compounds/*adverse effects,Neurodevelopmental Disorders/*chemically induced}
}

