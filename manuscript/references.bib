  keywords = {*Child Development,*Cognition,Cadmium,Child,Child Preschool,Cord blood,Female,Fetal Blood/*chemistry,Humans,Infant,Intelligence,Lead,Maternal Exposure,Mercury,Metals Heavy/*blood,Pregnancy,Prospective Studies,Republic of Korea,Stability}
}

