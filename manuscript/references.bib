@article{tippairote2019PrevalenceFactorsAssociated,
  title = {Prevalence and {{Factors Associated}} with {{High Levels}} of {{Aluminum}}, {{Arsenic}}, {{Cadmium}}, {{Lead}}, and {{Mercury}} in {{Hair Samples}} of {{Well-Nourished Thai Children}} in {{Bangkok}} and {{Perimeters}}},
  author = {Tippairote, T. and Temviriyanukul, P. and Benjapong, W. and Trachootham, D.},
  year = 2019,
  month = apr,
  journal = {Biological trace element research},
  edition = {2018/07/15},
  volume = {188},
  number = {2},
  pages = {334--343},
  issn = {0163-4984},
  doi = {10.1007/s12011-018-1435-6},
  abstract = {Toxic element exposure increases risk of neurodevelopmental disorders. However, hair element profiles of well-nourished urban resident children were largely unknown. We identified prevalence and the contributing factors of high hair aluminum (Al), arsenic (As), cadmium (Cd), lead (Pb), and mercury (Hg) levels in 111 Thai children (aged 3-7~years old). Most participants were well-nourished with high socioeconomic status. Since ROC curve of hair element data showed inadequate sensitivity for cutoff set-up, US reference hair levels were used to categorize high and low level groups. Nevertheless, compared to the current reference at 5~{$\mu$}g/dL, blood lead cutoff at 2.15~{$\mu$}g/dL provided more consistent results with that of hair lead levels. High As and Pb levels were the first and second most prevalent element, while Al was the element found in highest amount in hair. High hair Al (12\% prevalence) levels were associated with being male regardless of age or nutritional status. High hair As levels were associated with living in Bangkok (OR\,=\,6.57) regardless of school type. High hair Pb levels were associated with being under 5~years old and living in Bangkok (OR\,=\,3.06). However, no associations were found between blood Pb, hair Cd, Hg, and tested factors. These findings suggested that under 5-year-old boys living in capital city like Bangkok may be at risk of exposure to multiple toxic elements. Future studies in these children are warranted to identify their exposure sources and proper risk management strategies.},
  langid = {english},
  keywords = {Age Factors,Aluminum,Aluminum/*analysis/blood,Arsenic/*analysis/blood,Bangkok,Blood lead,Cadmium/analysis/blood,Child,Child Preschool,Environmental Exposure/*analysis,Environmental Pollutants/*analysis/blood,Female,Hair,Hair/*chemistry,Humans,Lead/*analysis/blood,Male,Mercury/analysis/blood,Nutrition Surveys,Prevalence,ROC Curve,Thai children,Thailand,Toxic element,Urban Population,Well-nourished}
}

