@article{marques2016NeurodevelopmentAmazonianChildren,
  title = {Neurodevelopment of {{Amazonian}} Children Exposed to Ethylmercury (from {{Thimerosal}} in Vaccines) and Methylmercury (from Fish)},
  author = {Marques, R. C. and Abreu, L. and Bernardi, J. V. E. and D{\'o}rea, J. G.},
  year = 2016,
