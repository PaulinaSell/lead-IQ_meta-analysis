@article{halonen2009ParticulateAirPollution,
  type = {Journal {{Article}}},
  title = {Particulate Air Pollution and Acute Cardiorespiratory Hospital Admissions and Mortality among the Elderly},
  author = {Halonen, J. I. and Lanki, T. and {Yli-Tuomi}, T. and Tiittanen, P. and Kulmala, M. and Pekkanen, J.},
