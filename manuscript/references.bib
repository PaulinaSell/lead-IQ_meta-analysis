@article{liu2015AssessmentAssociationDopamine,
  title = {Assessment of Association between the Dopamine {{D2}} Receptor ({{DRD2}}) Polymorphism and Neurodevelopment of Children Exposed to Lead},
  author = {Liu, L. and Xu, X. and Yekeen, T. A. and Lin, K. and Li, W. and Huo, X.},
  year = 2015,
  month = feb,
  journal = {Environmental science and pollution research international},
  edition = {2014/01/29},
  volume = {22},
  number = {3},
  pages = {1786--93},
  issn = {0944-1344},
  doi = {10.1007/s11356-014-2565-9},
  abstract = {The mechanism of lead (Pb) neurotoxicity has not been illustrated over the years. People pay more attention to dopaminergic neurotransmission, specifically dopamine receptor-2 (DRD2) Taq IA polymorphism, but no consensus has been reached. A total of 258 three-year-old children in Guiyu (exposed group) and Nanao (reference group), China were examined and their concentrations of blood lead (BPb) were determined. Cognitive and language scores of children were assessed using the Bayley Scales of Infant Development, third edition (BSID-III). Genotyping for the DRD2 polymorphism was carried out using a polymerase chain reaction (PCR) re-sequencing platform. The logistic stepwise regression analysis and stepwise regression analysis was used to explore associations among lead, neurodevelopment of children, and DRD2 Taq IA categories. Median values of Pb in Guiyu was higher than that of the reference group (11.30\,\textpm\,5.38 {$\mu$}g/dL vs. 5.77\,\textpm\,2.51 {$\mu$}g/dL, P\,{$<$}\,0.001). Compared with the reference group, children from e-waste exposed area have lower cognitive scale scores (100\,\textpm\,25 vs 120\,\textpm\,20, P\,{$<$}\,0.001) and lower language scale scores (99.87\,\textpm\,7.52 vs 111.39\,\textpm\,7.02, P\,{$<$}\,0.001). The three kinds of genotype, A1/A1, A1/A2, and A2/A2, had no significant influences on BPb, cognitive scores and language scores (P\,{$>$}\,0.05). Exposure of inhabitants, especially children to Pb from informal e-waste recycling activities might have contributed to higher levels of BPb and reduced cognitive and language scores observed in local children, however, the result obtained showed no significant association between DRD2 polymorphism and neurodevelopment of children exposed to lead.},
  langid = {english},
  keywords = {*Electronic Waste,Child Development/drug effects,Child Preschool,China,Cognition,Environmental Exposure/*analysis,Environmental Pollutants/*blood,Genotype,Humans,Language,Lead/*blood,Polymorphism Genetic,Receptors Dopamine D2/*genetics,Recycling}
}

