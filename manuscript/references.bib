@article{ahmad2020AscorbingPbNeurotoxicity,
  title = {({{Ascorb}})Ing {{Pb Neurotoxicity}} in the {{Developing Brain}}},
  author = {Ahmad, F. and Liu, P.},
  year = 2020,
  month = dec,
  journal = {Antioxidants (Basel, Switzerland)},
  edition = {2020/12/30},
  volume = {9},
  number = {12},
  issn = {2076-3921 (Print) 2076-3921},
  doi = {10.3390/antiox9121311},
  abstract = {Lead (Pb) neurotoxicity is a major concern, particularly in children. Developmental exposure to Pb can alter neurodevelopmental trajectory and has permanent neuropathological consequences, including an increased vulnerability to further stressors. Ascorbic acid is among most researched antioxidant nutrients and has a special role in maintaining redox homeostasis in physiological and physio-pathological brain states. Furthermore, because of its capacity to chelate metal ions, ascorbic acid may particularly serve as a potent therapeutic agent in Pb poisoning. The present review first discusses the major consequences of Pb exposure in children and then proceeds to present evidence from human and animal studies for ascorbic acid as an efficient ameliorative supplemental nutrient in Pb poisoning, with a particular focus on developmental Pb neurotoxicity. In doing so, it is hoped that there is a revitalization for further research on understanding the brain functions of this essential, safe, and readily available vitamin in physiological states, as well to justify and establish it as an effective neuroprotective and modulatory factor in the pathologies of the nervous system, including developmental neuropathologies.},
  langid = {english},
  keywords = {antioxidant,ascorbate,blood lead level (BLL),chelation,dehydroascorbate,design of the study,in,in the collection analyses or interpretation of data,lead,neuronal,nutrient,the writing of the manuscript or in the decision to publish the results.,vitamin C}
}

