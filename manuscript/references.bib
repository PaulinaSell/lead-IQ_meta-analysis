@article{wu2014EffectLowlevelPrenatal,
  title = {Effect of Low-Level Prenatal Mercury Exposure on Neonate Neurobehavioral Development in {{China}}},
  author = {Wu, J. and Ying, T. and Shen, Z. and Wang, H.},
  year = 2014,
  month = jul,
  journal = {Pediatric neurology},
  edition = {2014/06/19},
  volume = {51},
  number = {1},
  pages = {93--9},
  issn = {0887-8994},
  doi = {10.1016/j.pediatrneurol.2014.03.018},
  abstract = {BACKGROUND: This study aimed to assess the effects of low-level prenatal mercury exposure on neonate neurobehavioral development in China. METHODS: In total, 418 mother-neonate pairs were included in the study. Maternal urine, hair, and blood samples and cord blood samples were used to document prenatal exposure to mercury. The Neonatal Behavioral Neurological Assessment was used to estimate neurobehavioral development in the neonates at 3 days of age. RESULTS: Total mercury level was significantly higher in cord blood than that in maternal blood. A strong correlation was found between total mercury levels in maternal blood and those in cord blood (r = 0.7431; P {$<$} 0.0001). Trend analysis revealed that mothers who consumed more fish had higher blood and cord blood mercury levels (all P {$<$} 0.0001). Significant differences were also found between male and female cord blood mercury levels among groups with different fish consumption frequencies (all P {$<$} 0.0001). Cord blood mercury level was significantly associated with total Neonatal Behavioral Neurological Assessment scores ({$\beta$} = 0.03; standard error = 0.01; P = 0.0409), passive muscle tone (odds ratio = 1.07; 95\% confidence interval = 1.12-1.13; P = 0.0071), and active muscle tone (odds ratio = 1.06; 95\% confidence interval = 1.01-1.11; P = 0.0170) scores after adjustment, respectively. CONCLUSIONS: Neonatal neurodevelopment was associated with prenatal exposure to mercury. Women with high mercury levels should avoid intake seafood excessively during pregnancy. Long-term effects of exposure to mercury on childhood development need to be further explored.},
  langid = {english},
  keywords = {Animals,Child Preschool,China/epidemiology,Cognition Disorders/*etiology,Developmental Disabilities/*etiology,Female,Fetal Blood/chemistry,fish consumption,Fishes,Humans,Infant,Infant Newborn,Male,mercury,Mercury Poisoning/epidemiology/*physiopathology,Mercury/analysis,Minimata disease,neurobehavioral development,Pregnancy,Prenatal Exposure Delayed Effects/epidemiology/*physiopathology,Retrospective Studies,Surveys and Questionnaires}
}

