@article{huang2012ChildhoodBloodLead,
  title = {Childhood Blood Lead Levels and Intellectual Development after Ban of Leaded Gasoline in {{Taiwan}}: A 9-Year Prospective Study},
  author = {Huang, P. C. and Su, P. H. and Chen, H. Y. and Huang, H. B. and Tsai, J. L. and Huang, H. I. and Wang, S. L.},
  year = 2012,
  month = apr,
  journal = {Environment international},
  edition = {2012/01/28},
  volume = {40},
  pages = {88--96},
  issn = {0160-4120},
  doi = {10.1016/j.envint.2011.10.011},
  abstract = {BACKGROUND: Lead (Pb) exposure is associated with children's neurodevelopment, even at low doses. Leaded gasoline was banned in Taiwan in 2000 to reduce environmental exposure to Pb. OBJECTIVES: To evaluate the neurodevelopmental effect of low-level Pb exposure in young children. METHODS: In 2001-2002, we have recruited 430 pregnant women in the third-trimester in Taichung, Taiwan who answered detailed questionnaires in the obstetric clinic. A total of 119, 76, and 66 children were followed up at 2-3, 5-6 and 8-9 years, respectively. We collected blood samples from pregnant women, Umbilical cord and children, and evaluated children's neurodevelopment and cognition function at all three time points using Bayley and Wechsler tests. Blood samples were analyzed for whole blood lead (BPb) levels. RESULTS: Geometric mean of BPb in pregnant women, cord blood and children at 2-3, 5-6 and 8-9 years old were 2.21, 1.30, 2.48, 2.49 and 1.97 {$\mu$}g/dl, respectively. Low-level postnatal Ln BPb was significantly associated with not only decreasing intelligence quotient (IQ), but also delayed cognitive function in children at 5-8 years ({$\beta$}: -5.97, SE: 2.59, p=0.025), after adjustment for maternal education, maternal BPb exposure, Home Observation for Measurement of the Environment Inventory (HOME), and gender of child, using linear mixed models. No significant relation was observed between prenatal and cord blood Pb levels and children's cognitive function in children 2-8 years. CONCLUSIONS: Low-level postnatal BPb levels in children at 2-5 years may have lagged effects on neurodevelopment in those at 5 to 8 years. Action is warranted to reduce even very low environmental Pb levels to reduce the developmental burden of Pb on children.},
  langid = {english},
  keywords = {*Child Development,*Cognition,*Gasoline,Adult,Air Pollutants/*blood,Air Pollution/*legislation & jurisprudence,Child,Child Preschool,Environmental Exposure/*analysis/statistics & numerical data,Female,Fetal Blood/metabolism,Humans,Intelligence,Lead/*blood,Linear Models,Male,Maternal Exposure/statistics & numerical data,Pregnancy,Prospective Studies,Taiwan,Young Adult}
}

