@article{drum2009AreToxicBiometals,
  title = {Are Toxic Biometals Destroying Your Children's Future?},
  author = {Drum, D. A.},
  year = 2009,
  month = oct,
  journal = {Biometals : an international journal on the role of metal ions in biology, biochemistry, and medicine},
  edition = {2009/02/12},
  volume = {22},
  number = {5},
  pages = {697--700},
  issn = {0966-0844},
  doi = {10.1007/s10534-009-9212-9},
  abstract = {Cadmium, arsenic, lead, and mercury have been linked to autism, attention deficit disorder, mental retardation and death of children. Mercury in thimerosal found in many vaccines and flu shots contributes significantly to these problems. Decomposition of the thimerosal can produce more toxic compounds, either methylethylmercury or diethylmercury, in the body. These compounds have a toxicity level similar to dimethylmercury. Within the human body, a mitochondrial disorder may release the more toxic form of mercury internally. Young children and pregnant women must minimize internal exposure to the vaccines and flu shots containing mercury.},
