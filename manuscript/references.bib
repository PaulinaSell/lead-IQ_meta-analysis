@article{atkinson2014EpidemiologicalTimeSeries,
  type = {Journal {{Article}}},
  title = {Epidemiological Time Series Studies of {{PM2}}.5 and Daily Mortality and Hospital Admissions: A Systematic Review and Meta-Analysis},
  author = {Atkinson, R. W. and Kang, S. and Anderson, H. R. and Mills, I. C. and Walton, H. A.},
