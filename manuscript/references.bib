  keywords = {*Environmental Exposure,*Ethnicity,Adult,Antenatal care utilization and content,Birth outcomes,Female,Humans,Indigenous,Infant Low Birth Weight,Infant Newborn,Lead,Logistic Models,Maternal Age,Mercury,Parity,Pregnancy,Pregnancy Outcome/*epidemiology,Premature Birth/*epidemiology,Prenatal Care/*statistics & numerical data,Rainforest,Retrospective Studies,Suriname,Suriname/epidemiology,Tribal,Young Adult}
