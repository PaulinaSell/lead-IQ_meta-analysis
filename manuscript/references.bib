@article{deassisaraujo2022PrenatalExposureMetals,
  title = {Prenatal {{Exposure}} to {{Metals}} and {{Neurodevelopment}} in {{Infants}} at {{Six Months}}: {{Rio Birth Cohort Study}} of {{Environmental Exposure}} and {{Childhood Development}} ({{PIPA Project}})},
  author = {{de Assis Araujo}, M. S. and {Froes-Asmus}, C. I. R. and {de Figueiredo}, N. D. and Camara, V. M. and Luiz, R. R. and {Prata-Barbosa}, A. and Martins, M. M. and Jacob, S. D. C. and Santos, Lmgd and Vicentini Neto, S. A. and Rezende Filho, J. F. and Amim Junior, J.},
  year = 2022,
  month = apr,
  journal = {International journal of environmental research and public health},
  edition = {2022/04/13},
  volume = {19},
  number = {7},
  issn = {1661-7827 (Print) 1660-4601},
  doi = {10.3390/ijerph19074295},
  abstract = {The PIPA Project is a prospective birth cohort study based in Rio de Janeiro, Brazil, whose pilot study was carried out between October 2017 and August 2018. Arsenic (As), cadmium (Cd), lead (Pb), and mercury (Hg) concentrations were determined in maternal (n = 49) and umbilical cord blood (n = 46). The Denver Developmental Screening Test II (DDST-II) was applied in 50 six-month-old infants. Metals were detected in 100\% of the mother and newborn samples above the limits of detection. Maternal blood lead concentrations were higher in premature newborns (GM: 5.72 \textmu g/dL; p = 0.05). One-third of the infants (n = 17-35.4\%) exhibited at least one fail in the neurodevelopment evaluation (fail group). Maternal blood arsenic concentrations were significantly (p = 0.03) higher in the "fail group" (GM: 11.85 \textmu g/L) compared to infants who did not fail (not fail group) (GM: 8.47 \textmu g/L). Maternal and umbilical cord blood arsenic concentrations were higher in all Denver Test's domains in the "fail group", albeit non-statistically significant, showing a tendency for the gross motor domain and maternal blood (p = 0.07). These findings indicate the need to further investigate the toxic effects of prenatal exposure to metals on infant neurodevelopment.},
  langid = {english},
  keywords = {*Arsenic,*Mercury,*Prenatal Exposure Delayed Effects/epidemiology,Birth Cohort,Brazil/epidemiology,Child,children's health,Cohort Studies,Environmental Exposure,Female,heavy metals,Humans,Infant,Infant Newborn,Lead,neurodevelopment,neurodevelopmental screening,Pilot Projects,Pregnancy,prenatal exposures,Prospective Studies,umbilical cord blood}
}

