@article{fagundes2022MethylmercuryExposurePrenatal,
  title = {Methylmercury Exposure during Prenatal and Postnatal Neurodevelopment Promotes Oxidative Stress Associated with Motor and Cognitive Damages in Rats: An Environmental-Experimental Toxicology Study},
  author = {Fagundes, B. H. F. and Nascimento, P. C. and Arag{\~a}o, W. A. B. and Chemelo, V. S. and Bittencourt, L. O. and {Eir{\'o}-Quirino}, L. and Silva, M. C. F. and Freire, M. A. M. and Fernandes, L. M. P. and Maia, Cdsf and {Crespo-Lopez}, M. E. and Lima, R. R.},
  year = 2022,
  journal = {Toxicology reports},
  edition = {2022/04/09},
  volume = {9},
  pages = {563--574},
  issn = {2214-7500},
  doi = {10.1016/j.toxrep.2022.02.014},
  abstract = {The environmental contamination by methylmercury (MeHg) is a major concern for public health. The effects of MeHg in the central nervous system (CNS) of adult animals have been extensively investigated; however, little is known about the effects of MeHg exposure during intrauterine and lactation periods on motor and cognitive functions of adolescent rats. Therefore, this study aimed to investigate the effect of MeHg exposure during intrauterine life and lactation on both motor and cognitive functions of offspring rats. Ten female Wistar rats were exposed to 40~{$\mu$}g/kg/day of MeHg through cookie treats from the first day of pregnancy until the last day of breastfeeding. Both motor and cognitive functions of offspring male rats were assessed by open field, rotarod, and step-down inhibitory avoidance tests. Forty-one days after birth, the hippocampus and cerebellum were collected to determine total Hg content, antioxidant capacity against peroxyl radicals (ACAP), reduced glutathione (GSH) levels, lipid peroxidation (LPO), and nitrite levels. MeHg exposure during CNS development increased Hg levels in both hippocampal and cerebellar parenchymas, triggered oxidative stress throughout ACAP and GSH decrease, increased LPO and nitrite levels. These alterations resulted in reduced spontaneous and stimulated locomotion and short- and long-term memory deficits. Therefore, damages triggered by MeHg exposure during intrauterine life and lactation had detrimental effects on oxidative biochemistry and motor and cognitive functions of offspring rats.},
  langid = {english},
  keywords = {Central nervous system,Cerebellum,Hippocampus,Methylmercury,Neurotoxicology,personal relationships that could have appeared to influence the work reported in,this paper.}
}

