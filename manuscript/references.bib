@article{menezes-filho31EnvironmentalCoExposureLead,
  title = {Environmental {{Co-Exposure}} to {{Lead}} and {{Manganese}} and {{Intellectual Deficit}} in {{School-Aged Children}}},
  author = {{Menezes-Filho}, J. A. and Carvalho, C. F. and Rodrigues, J. L. G. and Ara{\'u}jo, C. F. S. and Dos Santos, N. R. and Lima, C. S. and Bandeira, M. J. and Marques, B. L. S. and Anjos, A. L. S. and Bah, H. A. F. and Abreu, N. and Philibert, A. and Mergler, D.},
  year = 31,
  month = oct,
  journal = {International journal of environmental research and public health},
  edition = {2018/11/06},
  volume = {15},
  number = {11},
  issn = {1661-7827 (Print) 1660-4601},
  doi = {10.3390/ijerph15112418},
  abstract = {Studies have demonstrated that, for urban children, dust represents the main exposure to sources of metals like lead (Pb) and manganese (Mn). We aimed to investigate the exposure to these metals and their association with intellectual deficit in children living in an industrial region. This cross-sectional study recruited volunteers from four elementary schools in the town of Sim\~oes Filho, Brazil. We evaluated 225 school-aged children (7{$^-$}12 years) for blood lead (PbB) and manganese hair (MnH) and toenails (MnTn) by graphite furnace atomic absorption spectrometry. Child and maternal IQs were estimated using the Wechsler Abbreviated Scale for Intelligence (WASI). Median and range PbB were 1.2 (0.3{$^-$}15.6) {$\mu$}g/dL. MnH and MnTn medians (ranges) were 0.74 (0.16{$^-$}8.79) {$\mu$}g/g and 0.85 (0.15{$^-$}13.30) {$\mu$}g/g, respectively. After adjusting for maternal IQ, age and Mn exposure, child IQ drops by 8.6 points for a 10-fold increase in PbB levels. Moreover, an effect modification of Mn co-exposure was observed. In children with low MnTn, association between Pb and child IQ was not significant ({$\beta$} = -6.780, p = 0.172). However, in those with high MnTn, the association was increased by 27.9\% ({$\beta$} = -8.70, p = 0.036). Low Pb exposure is associated with intellectual deficit in children, especially in those with high MnTn.},
  langid = {english},
  keywords = {Brain Diseases,Brazil,Child,children,Cross-Sectional Studies,Dust/*analysis,environmental contamination,Environmental Exposure/*adverse effects/analysis,Environmental Monitoring,Female,Hair/chemistry,Humans,intellectual function,Intelligence Tests,Intelligence/*physiology,lead,Lead/*adverse effects/blood,Male,manganese,Manganese Poisoning/epidemiology,Manganese/*adverse effects/blood,Manufacturing and Industrial Facilities,Nails/chemistry,Schools,Students/*statistics & numerical data,Urban Population/statistics & numerical data}
}

