@article{davidson2020PrinciplesStudyingLowlevel,
  title = {Principles of Studying Low-Level Neurotoxic Exposures in Children: Using the {{Seychelles Child Development Study}} of Methyl Mercury as a Prototype},
  author = {Davidson, P. W. and Myers, G. J. and Shamlaye, C.},
  year = 2020,
  month = dec,
  journal = {Neurotoxicology},
  edition = {2021/03/21},
  volume = {81},
  pages = {307--314},
  issn = {0161-813x},
  doi = {10.1016/j.neuro.2020.09.022},
  abstract = {Epidemiological studies to determine the impact of low level toxic exposure on child development are important in guiding clinical and public health action. However, carrying out such studies and interpreting their findings presents a number of significant challenges to the investigators. First, they must find a cohort with suitable exposure, select a biomarker that will accurately determine the level of exposure and determine the endpoints that are most likely to detect subtle differences in neurodevelopment. Following that, the logistics of the study must be organised and collaboration established with the local population and health authorities. To accurately interpret the data, they must also accurately determine covariates that impact child development. After the data are collected, interpreting the findings presents a further challenge. Throughout this process, the study must adhere to fundamental epidemiological principles and clearly defined statistical approaches. This paper discusses those principles and uses the Seychelles Child Development Study to show how one epidemiological study addressed them.},
  langid = {english},
  keywords = {*Child Development,*Food Contamination,Age Factors,child behaviour,child development,Child Preschool,Dietary Exposure/*adverse effects,epidemiological studies,Female,fish consumption,Humans,Infant,Maternal Exposure/*adverse effects,Mercury Poisoning Nervous System/diagnosis/*epidemiology/physiopathology,methyl mercury,Methylmercury Compounds/*adverse effects,Nervous System/*drug effects/growth & development,neurodevelopment,postnatal exposure,Pregnancy,prenatal exposure,Prenatal Exposure Delayed Effects,Research Design,Risk Assessment,Risk Factors,Seafood/*adverse effects,Seychelles,Seychelles/epidemiology}
}

