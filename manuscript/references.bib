@article{al-saleh2019SeleniumStatusLactating,
  title = {Selenium Status in Lactating Mothers-Infants and Its Potential Protective Role against the Neurotoxicity of Methylmercury, Lead, Manganese, and {{DDT}}},
  author = {{Al-Saleh}, I. and {Al-Mohawes}, S. and {Al-Rouqi}, R. and Elkhatib, R.},
  year = 2019,
