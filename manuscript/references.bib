@article{trdin2019MercurySpeciationPrenatal,
  title = {Mercury Speciation in Prenatal Exposure in {{Slovenian}} and {{Croatian}} Population - {{PHIME}} Study},
  author = {Trdin, A. and Snoj Tratnik, J. and Mazej, D. and Fajon, V. and Krsnik, M. and Osredkar, J. and Prpi{\'c}, I. and {\v S}piri{\'c}, Z. and Petrovi{\'c}, O. and Marc, J. and Neubauer, D. and Kodri{\v c}, J. and Kobal, A. B. and Barbone, F. and Falnoga, I. and Horvat, M.},
  year = 2019,
  month = oct,
  journal = {Environmental research},
  edition = {2019/08/20},
  volume = {177},
  pages = {108627},
  issn = {0013-9351},
  doi = {10.1016/j.envres.2019.108627},
  abstract = {In recent years, several studies have addressed the issue of prenatal exposure to methylmercury (MeHg); however, few have actually analysed MeHg blood concentrations. Our study population included mothers and their new-borns from Slovenia (central region; N\,=\,584) and Croatia (coastal region; N\,=\,234). We have measurements of total Hg (THg) and MeHg in maternal hair, maternal peripheral blood, and cord blood. Cord blood Hg concentrations were low to moderate (median THg\,=\,1.84\,ng/g and MeHg\,=\,1.69\,ng/g). The proportion of THg as MeHg (\%MeHg) in maternal and cord blood varied between 4\% and 100\% (coefficient of variation, CV\,=\,32\%) and between 8\% and 100\% (CV\,=\,20\%), respectively. Our data shows that variability of \%MeHg was higher at lower blood THg levels. Concentrations of MeHg in maternal blood and cord blood were highly correlated (R(s)\,=\,0.943), in the case of inorganic Hg correlation was significant but weaker (R(s)\,=\,0.198). MeHg levels in maternal blood and cord blood were positively associated with seafood intake, maternal age, and negatively associated with pre-pregnancy BMI. Additionally, MeHg in maternal blood was positively associated with plasma selenium levels, and cord blood MeHg was negatively associated with parity. The results of multiple linear regression models showed that speciation analysis provides more defined estimation of prenatal exposure in association modelling. Associations between Hg exposure and cognitive performance of children (assessed using Bayley Scales of Infant and Toddler development) adjusted for maternal or child Apolipoprotein E genotypes showed higher model R(2) and lower p-values when adjusted for MeHg compared to THg. This study demonstrates that Hg speciation improves the association between exposure and possible negative health effects.},
  langid = {english},
  keywords = {*Maternal Exposure,Apolipoprotein E (ApoE),Croatia,Female,Fetal Blood,Humans,Infant Newborn,Mercury/*blood,Methylmercury,Methylmercury Compounds/*blood,Neurodevelopment,Pregnancy,Prenatal exposure,Slovenia,Speciation}
}

