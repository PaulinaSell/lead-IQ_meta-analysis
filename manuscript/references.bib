@article{solan2014MercuryExposurePregnancy,
  title = {Mercury Exposure in Pregnancy: A Review},
  author = {Solan, T. D. and Lindow, S. W.},
  year = 2014,
  month = nov,
  journal = {Journal of perinatal medicine},
  edition = {2014/04/05},
  volume = {42},
  number = {6},
  pages = {725--9},
  issn = {0300-5577},
  doi = {10.1515/jpm-2013-0349},
  abstract = {Mercury exposure in pregnancy has been associated with both pregnancy complications and developmental problems in infants. Apart from industrial accidents and contaminated food, mercury exposure is likely to arise from predatory fish consumption, environmental contamination and dental amalgam restorations placed before or during pregnancy. It would be prudent to recommend that pregnant women avoid these potential problems and minimize any risk. The available literature indicates a linear relationship with mercury levels and IQ deficit, and therefore a safe limit of mercury cannot be calculated.},
  langid = {english},
  keywords = {Developmental Disabilities/*chemically induced,Environmental Exposure/*adverse effects,Environmental Pollutants/analysis/metabolism/*toxicity,Female,Humans,Infant,Infant Newborn,Mercury/analysis/metabolism/*toxicity,Pregnancy,Pregnancy Complications/*chemically induced,Prenatal Exposure Delayed Effects/*chemically induced}
}

