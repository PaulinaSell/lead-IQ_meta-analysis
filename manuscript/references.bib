@article{grandjean2007EffectIndustrialChemicals,
  title = {{[Effect of industrial chemicals on development of the nerve system--secondary publication]}},
  author = {Grandjean, P.},
  year = 2007,
  month = aug,
  journal = {Ugeskrift for laeger},
  edition = {2007/09/20},
  volume = {169},
  number = {34},
  pages = {2782--4},
  issn = {0041-5782},
  abstract = {Neurodevelopmental disorders are common, but their aetiology is mostly unknown. A small number of industrial chemicals--lead, methylmercury, polychlorinated biphenyls, arsenic and toluene--are known causes of such diseases and of subclinical brain dysfunction. Developmental exposure can cause brain injury at dose levels much lower than those affecting adults. We have identified over 200 chemicals that can cause neurotoxicity in adults, but they are not regulated so that children are protected. New approaches to prevention must recognise the unique vulnerability of the developing brain.},
  langid = {danish}
}

