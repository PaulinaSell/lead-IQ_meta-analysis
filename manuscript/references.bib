@article{kashala-abotnes2016LeadExposureEarly,
  title = {Lead Exposure and Early Child Neurodevelopment among Children 12-24 Months in {{Kinshasa}}, the {{Democratic Republic}} of {{Congo}}},
  author = {{Kashala-Abotnes}, E. and Mumbere, P. P. and Mishika, J. M. and Ndjukendi, A. O. and Mpaka, D. B. and Bumoko, M. G. and Kayembe, T. K. and {Tshala-Katumbay}, D. and Kazadi, T. K. and Okitundu, D. L.},
  year = 2016,
  month = dec,
  journal = {European child \& adolescent psychiatry},
  edition = {2016/05/12},
  volume = {25},
  number = {12},
  pages = {1361--1367},
  issn = {1018-8827 (Print) 1018-8827},
  doi = {10.1007/s00787-016-0860-3},
  abstract = {Childhood lead exposure remains a problem in developing countries, and little is known about its effects on early child neurodevelopment and temperament in the Democratic Republic of Congo (DRC). We, therefore, conducted this study to determine the association between lead exposure and the neurodevelopment and behaviour of children aged 12-24~months in Kinshasa, DRC. A cross-sectional study was conducted between February and June 2012, and parents of 104 children were invited to participate. Blood lead levels (BLLs) of each child were tested using the flame atomic spectrophotometry method. All children were subject to a clinical examination and assessed with two selected early child neurodevelopmental tools, the Gensini-Gavito and the baby characteristics questionnaire, to measure their neurodevelopment and temperament. Detectable BLLs ranged from 1 to 30~{$\mu$}g/dl with a geometric mean of 6.9 (SD 4.8)~{$\mu$}g/dl. BLLs at 5-9 and~{$\geq$}10~{$\mu$}g/dl were significantly associated with the child temperament (p~{$<$}0.05). Perinatal and maternal factors did not seem to affect early child neurodevelopment and temperament. Children exposed to lead were reported with more temperament difficulties at even blood lead levels~{$<$}10~{$\mu$}g/dl, suggesting the need for preventive and intervention measures to reduce lead exposure among children in Kinshasa, DRC.},
  langid = {english},
  keywords = {Adult,Child Development/*physiology,Child Preschool,Childhood,Cross-Sectional Studies,Democratic Republic of the Congo/epidemiology,Female,Humans,Infant,Kinshasa/DRC,Lead exposure,Lead/adverse effects/*blood,Male,Neurodevelopment,Neurodevelopmental Disorders/*blood/chemically induced/*epidemiology,Pregnancy,Surveys and Questionnaires,Temperament,Temperament/*physiology,they have no conflict of interests.}
}

