@article{desrochers-couture2018PrenatalConcurrentSexspecific,
  type = {Journal {{Article}}},
  title = {Prenatal, Concurrent, and Sex-Specific Associations between Blood Lead Concentrations and {{IQ}} in Preschool {{Canadian}} Children},
  author = {{Desrochers-Couture}, Mireille and Oulhote, Youssef and Arbuckle, Tye E. and Fraser, William D. and S{\'e}guin, Jean R. and Ouellet, Emmanuel and {Forget-Dubois}, Nadine and Ayotte, Pierre and Boivin, Michel and Lanphear, Bruce P. and Muckle, Gina},
  year = 2018,
  journal = {Environment International},
  volume = {121},
  pages = {1235--1242},
  issn = {0160-4120},
  doi = {10.1016/j.envint.2018.10.043},
  abstract = {Background Lead exposure predicts altered neurodevelopment and lower intelligence quotient (IQ) in children, but few studies have examined this association in children who have relatively low blood lead concentrations. Objectives To test the associations between blood lead concentrations and cognitive function in Canadian preschoolers, with a possible moderation by sex. Methods The data were gathered from 609 mother-child pairs from the Maternal--Infant Research on Environmental Chemicals (MIREC) Study. Lead was measured in umbilical and maternal blood, and in children's venous blood at age 3--4 years. Cognitive function was measured with the Wechsler Preschool and Primary Scale of Intelligence (WPPSI-III) at 3--4 years. We tested the relationship between WPPSI-III scores and blood lead concentrations with multiple linear regression, adding child sex as a moderator. Results Median blood lead concentrations for the mother at 1st trimester and 3rd trimester of pregnancy, and for cord and child blood were 0.60 {$\mu$}g/dL, 0.58 {$\mu$}g/dL, 0.79 {$\mu$}g/dL and 0.67 {$\mu$}g/dL, respectively. We found no association between cord blood lead concentrations and WPPSI-III scores in multivariable analyses. However, cord blood lead concentrations showed a negative association with Performance IQ in boys but not in girls (B = 3.44; SE = 1.62; 95\% CI: 0.82, 5.98). No associations were found between WPPSI-III scores and prenatal maternal blood or concurrent child blood lead concentrations. Conclusions Prenatal blood lead concentrations below 5 {$\mu$}g/dL were still associated with a decline in cognitive function in this Canadian cohort, but only for boys.},
  keywords = {*Cognition,*Environmental Exposure,Adult,Blood lead concentrations,Blood lead concentrations Sex differences Intelligence quotient Canadian children,Canada,Canadian children,Child Preschool,Female,Humans,Intelligence quotient,Intelligence Tests,Lead/*blood,Male,Middle Aged,Pregnancy,Prenatal Exposure Delayed Effects/*chemically induced,Sex differences,Young Adult}
}

