@article{ettinger2007DietaryCalciumSupplementation,
  title = {Dietary Calcium Supplementation to Lower Blood Lead Levels in Pregnancy and Lactation},
  author = {Ettinger, A. S. and Hu, H. and {Hernandez-Avila}, M.},
  year = 2007,
  month = mar,
  journal = {The Journal of nutritional biochemistry},
  edition = {2007/02/14},
  volume = {18},
  number = {3},
  pages = {172--8},
  issn = {0955-2863 (Print) 0955-2863},
  doi = {10.1016/j.jnutbio.2006.12.007},
  abstract = {Pregnancy and lactation are states known to be accompanied by physiologically up regulated bone resorption in response to the calcium demands of the developing fetus and nursing infant. The role of calcium supplements in altering maternal responses to fetal demand for calcium is not fully understood. Exposure to the toxicant lead is known to pose a major hazard to fetal neurodevelopment and growth. Since {$>$}95\% of maternal lead is stored in the bone, mobilization of cumulative maternal lead stores into the circulation represents an endogenous source of exposure, which may pose a significant hazard for the fetus and infant. Maternal dietary calcium supplementation has been associated with reductions in lead levels in both animal and human studies when administered during pregnancy and lactation. Therefore, supplementation of the maternal diet with calcium may represent an important secondary prevention strategy aimed not only at reducing circulating levels of lead in the mother but also at reducing lead exposure to the developing fetus and nursing infant.},
  langid = {english},
  keywords = {Animals,Bone and Bones/drug effects/metabolism,Bone Resorption/physiopathology,Calcium Dietary/*administration & dosage,Female,Fetus/drug effects,Humans,Lactation/*blood,Lead/*blood/metabolism,Pregnancy,Receptors Calcitriol/drug effects/genetics}
}

