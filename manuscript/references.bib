@article{al-saleh2020EffectsEarlyRecent,
  title = {Effects of Early and Recent Mercury and Lead Exposure on the Neurodevelopment of Children with Elevated Mercury and/or Developmental Delays during Lactation: {{A}} Follow-up Study},
  author = {{Al-Saleh}, I. and Moncari, L. and Jomaa, A. and Elkhatib, R. and {Al-Rouqi}, R. and Eltabache, C. and {Al-Rajudi}, T. and Alnuwaysir, H. and Nester, M. and Aldhalaan, H.},
  year = 2020,
  month = sep,
  journal = {International journal of hygiene and environmental health},
  edition = {2020/09/22},
  volume = {230},
  pages = {113629},
  issn = {1438-4639},
  doi = {10.1016/j.ijheh.2020.113629},
  abstract = {This follow-up study of 82 children investigated the potential impact of early and recent exposure to mercury and lead on their neurodevelopmental performance at 5-8 years of age (2017-2018). Early exposure of these children to mercury, methylmercury, and lead was assessed during lactation at 3-12 months old, as well as their mother's exposure using measurements from a cross-sectional study (2011-2013). Only infants who failed to pass the neurodevelopment screening tools and/or had elevated mercury were included in this study. Urine and hair were sampled during the follow-up study to assess the children's recent exposure to mercury, methylmercury, and lead. Their cognitive performance and visual-motor integration were also measured using the Test of Non-Verbal Intelligence (TONI) and the Beery-Visual-Motor Integration (Beery VMI), respectively. The association between alterations in urinary porphyrins excretion and exposure to metals was analyzed and their influence on the children's neurodevelopment was explored. Linear regression models revealed a significant negative association between the infants' mercury exposure during lactation and the TONI Quotient ({$\beta~$}=~-0.298, 95\%CI~=~-4.677, -0.414) and Beery VMI Age Equivalent scores at age 5-8 ({$\beta~$}=~-0.437, 95\%CI~=~-6.383, -1.844). The mothers' blood methylmercury was inversely and significantly associated with their children's TONI Quotient ({$\beta~$}=~-0.231, 95\%CI~=~-8.184, -0.331). In contrast, the children's Beery VMI Age Equivalent scores were positively and significantly associated with the hair methylmercury of the mothers ({$\beta~$}=~0.214, 95\%CI~=~0.088, 3.899) and their infants ({$\beta~$}=~0.256, 95\%CI~=~0.396, 4.488). These relationships suggest the presence of negative confounding that we did not take into account. Unlike mercury, there was some evidence that lead in breast milk had an inverse relationship with the children's visual-motor coordination skills. Our study did not show a clear association between children's recent exposure to metals and neurodevelopment. However, a significant inverse association was observed between the TONI Quotient and the interaction of hair methylmercury~\texttimes ~{$\sum$}porphyrins (\ss ~=~-0.224, 95\%CI~=~-0.86, -0.049), implying that porphyrins are a sensitive measure of low body-mercury burden. Although lead induced higher {$\sum$}porphyrins excretion in urine ({$\beta~$}=~0.347, 95\%CI~=~0.107, 0.525), their interaction did not influence children's neurodevelopmental scores. The interactions between metals and porphyrins might provide insights into their potential contributory role in the pathogenesis associated with neurological disorders or other diseases. Despite the small sample size of the present study, its findings about the association between toxic metal exposure and the high risk of poor neurodevelopmental performance are worrying, particularly at an early age, and additional research is needed using larger sample sizes.},
  langid = {english},
  keywords = {*Mercury,Child,Child Development,Child Preschool,Children,Cross-Sectional Studies,Female,Follow-up,Follow-Up Studies,Humans,Infant,Lactation,Lead,Mercury,Neurodevelopment,Porphyrins}
}

