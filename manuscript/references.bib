@article{marques2016ImpactOrganicMercury,
  title = {Impact of Organic Mercury Exposure and Home Delivery on Neurodevelopment of {{Amazonian}} Children},
  author = {Marques, R. C. and Bernardi, J. V. and Cunha, M. P. and D{\'o}rea, J. G.},
  year = 2016,
  month = aug,
  journal = {International journal of hygiene and environmental health},
  edition = {2016/06/07},
  volume = {219},
  number = {6},
  pages = {498--502},
  issn = {1438-4639},
  doi = {10.1016/j.ijheh.2016.05.002},
  abstract = {In the transitioning Amazon, we addressed birth environment (home vs hospital) and associated perinatal organic-Hg exposures: methylmercury (MeHg) from maternal fish consumption and ethylmercury (EtHg) from pediatric Thimerosal-containing vaccines (TCVs) taken systematically during hospital delivery. We studied 365 children in relation to linear growth at 60 months and neurodevelopment (milestone achievements, Bayley Scale of Infant Development/BSID at 24 months, and Stanford-Binet intelligence tests at 60 months). Mothers delivered in hospitals vs those gave birth at home had significantly (p{$<$}0.0001) lower hair-Hg (HHg) concentrations (12.2 vs 23.9{$\mu$}g/g respectively) and shorter length of breastfeeding (8.5 vs 9.7 months respectively). Home-born children had significantly (p{$<$}0.0001) higher HHg (7.1{$\mu$}g/g) than hospital-born children (4.6{$\mu$}g/g). Hospital-born children also had significantly earlier (p{$<$}0.0001) hepatitis B vaccine than home-born children (1.5 vs 24.1days respectively) and higher (p{$<$}0.0001) exposures to total TCV-EtHg (75.8 vs 49.3{$\mu$}g respectively). Neither anthropometric indices nor neurodevelopment (except for fluid reasoning) were directly affected by birth environment. The percentage of hospital-born children with BSID (MDI or PDI) scores {$<$}80 was not significantly different from those born at home. In spite of the differences in HHg and EtHg levels between hospital-born and home-born children, no impact on neurodevelopment was observed.},
  langid = {english},
  keywords = {*Child Development,*Home Childbirth,*Maternal Exposure,Animals,Brazil,Breast Feeding,Cesarean delivery,Child Preschool,Environmental Pollutants/*analysis,Ethylmercury,Female,Fishes,Food Contamination,Hair/chemistry,Hospitalization,Humans,Intelligence Tests,Mercury/analysis,Methylmercury,Methylmercury Compounds/*analysis,Pregnancy,Thimerosal,Vaccines}
}

