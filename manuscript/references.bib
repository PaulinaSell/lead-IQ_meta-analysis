@article{lu2023SexspecificAssociationsCord,
  title = {Sex-Specific Associations between Cord Blood Lead and Neurodevelopment in Early Life: {{The}} Mother-Child Cohort ({{Shanghai}}, {{China}})},
  author = {Lu, A. X. and Wang, S. S. and Xu, X. and Wu, M. Q. and Liu, J. X. and Xu, M. and Cao, L. L. and Wang, J. and Wu, W. and Li, H. and Yan, C. H.},
  year = 2023,
  month = jan,
  journal = {Ecotoxicology and environmental safety},
  edition = {2022/12/13},
  volume = {249},
  pages = {114337},
  issn = {0147-6513},
  doi = {10.1016/j.ecoenv.2022.114337},
  abstract = {The extent to which neurodevelopment is affected by prenatal lead exposure has not been conclusive. In addition, studies on the effects of sex on these relationships are inconsistent. The aim of this study was to investigate the impact of cord blood lead on neurodevelopment in children within sex subgroups. A total of 275 mother-child pairs from the Shanghai mother-child cohort were included. Umbilical cord blood lead was measured using graphite furnace atomic absorption spectrophotometry. The Bayley Scales for Infant Development-III (BSID-III) was used to measure the neurodevelopment of infants at the age of 18~\textpm ~1.5 months. The median and interquartile range of cord blood lead levels in the total participants, male, and female children were 44.0 (24.5) {$\mu$}g/L, 44.0 (24.3) {$\mu$}g/L, and 46.0 (24.0) {$\mu$}g/L, respectively. According to multiple linear regression, cord blood lead concentrations showed a negative association with fine motor scores in all models associated with female children ({$\beta~$}=~-1.5; 95\%confidence interval: -2.6, -0.4). However, prenatal lead levels were not associated with any of the BSID-III scores in male children. In addition, cord serum DHA was found positively related to fine motor scores in male children. Our findings suggest that prenatal lead exposure could lead to decreased motor function, although this phenomenon was only observed in female children. And DHA may be a protective factor against lead exposure in boys. Thus, further studies are needed to investigate the associations between prenatal lead exposure and neurobehavioral development, as well as the mechanism of sex differences.},
  langid = {english},
  keywords = {*Lead/toxicity,*Prenatal Exposure Delayed Effects,China,competing financial interests or personal relationships that could have appeared,Female,Fetal Blood,Humans,Infant,Lead,Male,Mother-Child Relations,Motor function,Neurodevelopment,Pregnancy,Prenatal exposure,to influence the work reported in this paper.}
}

