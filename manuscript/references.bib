@article{schaefer2019MercuryExposureFish,
  title = {Mercury {{Exposure}}, {{Fish Consumption}}, and {{Perceived Risk}} among {{Pregnant Women}} in {{Coastal Florida}}},
  author = {Schaefer, A. M. and Zoffer, M. and Yrastorza, L. and Pearlman, D. M. and Bossart, G. D. and Stoessel, R. and Reif, J. S.},
  year = 2019,
  month = dec,
  journal = {International journal of environmental research and public health},
  edition = {2019/12/11},
  volume = {16},
  number = {24},
  issn = {1661-7827 (Print) 1660-4601},
  doi = {10.3390/ijerph16244903},
  abstract = {Seafood consumption is the primary source of mercury (Hg) exposure, particularly among coastal populations. Hg exposure during pregnancy has been associated with cognitive impairment, as well as decrements in memory, attention, fine motor skills, and other markers of delayed neurodevelopment, although results are conflicting. High Hg hair concentrations in persons from coastal Florida, USA, have been previously reported. The purpose of the current study was to determine the concentrations of total Hg (THg) in the hair of pregnant women from this area and to assess the relationships between THg concentration, knowledge of the risks of mercury exposure, and dietary patterns among participants. Participants (n = 229) were recruited at prenatal clinics. Their mean total hair Hg concentration was 0.31 + 0.54 \textmu g/g, lower or similar to US data for women of child-bearing age. Hair THg concentration was associated with consumption of locally caught fish and all seafood, a higher level of education, and first pregnancy. Eighty-five percent of women were aware of the risks of mercury exposure during pregnancy; over half reported a decrease in seafood consumption during pregnancy. Awareness of Hg in fish was marginally associated with lower hair THg concentration (p = 0.06) but reduction in seafood consumption during pregnancy was not.},
  langid = {english},
  keywords = {*Health Knowledge Attitudes Practice,Adult,Biomarkers/analysis,Dietary Exposure/analysis/*statistics & numerical data,Female,fish consumption,Florida,Food Contamination/analysis/*statistics & numerical data,Hair/chemistry,Humans,Maternal Exposure/*statistics & numerical data,mercury,Mercury/*analysis,Pregnancy,prenatal contaminant exposure,Risk,seafood advisories,Seafood/*analysis,Water Pollutants Chemical/*analysis}
}

